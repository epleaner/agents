#!/usr/bin/env python3
"""Review meta-learning ledgers and optionally update statuses/owners.

The script scans every markdown file under `learnings/` (excluding `index.md`),
finds entries using the standard template, and surfaces those that still need
action (`new`, `needs-agents-update`, or `needs-spec-change` by default).

For each entry, you can update the status, owner, and follow-up links directly
from the prompt; the script rewrites the ledger file and keeps
`learnings/index.md` in sync. Use Ctrl+C to abort without saving the current
entry.
"""
from __future__ import annotations

import argparse
import pathlib
import re
from dataclasses import dataclass, field
from typing import Dict, List, Optional

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
LEARNINGS_DIR = REPO_ROOT / "learnings"
INDEX_FILE = LEARNINGS_DIR / "index.md"
ALLOWED_STATUSES = [
    "new",
    "needs-agents-update",
    "needs-spec-change",
    "in-progress",
    "promoted",
    "closed",
]
ATTENTION_STATUSES = {"new", "needs-agents-update", "needs-spec-change"}
FIELD_KEYS = {
    "Date",
    "Session",
    "Knowledge Type",
    "Meta Category",
    "Owner",
    "Status",
    "Related IDs",
    "Summary",
    "Recommended Action",
    "Supporting Links",
    "Follow-up Links",
}


@dataclass
class LedgerEntry:
    ledger_path: pathlib.Path
    title: str
    entry_id: str
    lines: List[str]
    field_line_indexes: Dict[str, int]
    heading_line_index: int
    in_attention_set: bool

    def get_field(self, name: str) -> str:
        idx = self.field_line_indexes.get(name)
        if idx is None:
            return ""
        line = self.lines[idx].strip()
        # line format: - Field: value
        parts = line.split(":", 1)
        return parts[1].strip() if len(parts) > 1 else ""

    def set_field(self, name: str, value: str) -> None:
        idx = self.field_line_indexes.get(name)
        if idx is None:
            return
        prefix = self.lines[idx].split(":", 1)[0]
        self.lines[idx] = f"{prefix}: {value}\n"


def parse_ledger(path: pathlib.Path, attention_statuses: set[str]) -> List[LedgerEntry]:
    lines = path.read_text().splitlines(keepends=True)
    entries: List[LedgerEntry] = []
    in_entries_section = False
    inside_code_block = False
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if stripped.startswith("```"):
            inside_code_block = not inside_code_block
        if stripped.startswith("## ") and "Entries" in stripped:
            in_entries_section = True
        if not in_entries_section or inside_code_block:
            i += 1
            continue
        if stripped.startswith("### ["):
            match = re.match(r"### \[([^]]+)\]\\s*(.*)", stripped)
            if not match:
                i += 1
                continue
            entry_id, title = match.groups()
            j = i + 1
            field_indexes: Dict[str, int] = {}
            while j < len(lines):
                candidate = lines[j]
                if candidate.strip().startswith("### [") or candidate.strip().startswith("## "):
                    break
                if candidate.strip() == "":
                    j += 1
                    continue
                if candidate.startswith("- "):
                    parts = candidate[2:].split(":", 1)
                    if len(parts) == 2:
                        field_name = parts[0].strip()
                        if field_name in FIELD_KEYS:
                            field_indexes[field_name] = j
                j += 1
            status_idx = field_indexes.get("Status")
            status = lines[status_idx].split(":", 1)[1].strip() if status_idx is not None else ""
            entry = LedgerEntry(
                ledger_path=path,
                title=title.strip(),
                entry_id=entry_id.strip(),
                lines=lines,
                field_line_indexes=field_indexes,
                heading_line_index=i,
                in_attention_set=status in attention_statuses,
            )
            entries.append(entry)
            i = j
            continue
        i += 1
    return entries


def load_ledgers(attention_statuses: set[str]) -> List[LedgerEntry]:
    entries: List[LedgerEntry] = []
    for ledger_path in sorted(LEARNINGS_DIR.glob("*.md")):
        if ledger_path.name == "index.md":
            continue
        entries.extend(parse_ledger(ledger_path, attention_statuses))
    return entries


def prompt_choice(prompt: str, default: str = "") -> str:
    try:
        response = input(prompt).strip()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        raise
    return response or default


def normalize_status(value: str) -> Optional[str]:
    if not value:
        return None
    lowered = value.lower()
    if lowered not in ALLOWED_STATUSES:
        print(f"Invalid status '{value}'. Allowed: {', '.join(ALLOWED_STATUSES)}")
        return None
    return lowered


def update_index(entry: LedgerEntry) -> None:
    if not INDEX_FILE.exists():
        return
    lines = INDEX_FILE.read_text().splitlines()
    header_idx = None
    for idx, line in enumerate(lines):
        if line.strip().startswith("| ID |"):
            header_idx = idx
            break
    if header_idx is None:
        return
    # Rows start after header_idx+2 (header + separator)
    start_idx = header_idx + 2
    row_found = False
    placeholder_idx = None
    for idx in range(start_idx, len(lines)):
        line = lines[idx].strip()
        if not line.startswith("|"):
            break
        columns = [col.strip() for col in line.strip("|").split("|")]
        if not columns or columns[0] == "_None yet_":
            placeholder_idx = idx
        if columns and columns[0] == entry.entry_id:
            row_found = True
            lines[idx] = format_index_row(entry)
            break
    if not row_found:
        if placeholder_idx is not None:
            # Remove placeholder row
            lines.pop(placeholder_idx)
        insert_idx = start_idx if placeholder_idx is not None else len(lines)
        lines.insert(insert_idx, format_index_row(entry))
    INDEX_FILE.write_text("\n".join(lines) + "\n")


def format_index_row(entry: LedgerEntry) -> str:
    owner = entry.get_field("Owner")
    status = entry.get_field("Status")
    follow_links = entry.get_field("Follow-up Links") or ""
    title = entry.title or "(untitled)"
    ledger_name = entry.ledger_path.name
    return f"| {entry.entry_id} | {title} | {ledger_name} | {owner} | {status} | {follow_links} |"


def process_entries(entries: List[LedgerEntry], interactive: bool) -> None:
    attention_seen = False
    for entry in entries:
        if interactive and not entry.in_attention_set:
            continue
        attention_seen = True
        print("\n" + "=" * 60)
        print(f"{entry.entry_id} · {entry.title} ({entry.ledger_path.name})")
        for field in ("Status", "Owner", "Recommended Action", "Summary"):
            print(f"{field}: {entry.get_field(field)}")
        if not interactive:
            continue
        entry_changed = False
        print(f"Allowed statuses: {', '.join(ALLOWED_STATUSES)}")
        while True:
            new_status = prompt_choice("New status (leave blank to keep): ")
            if not new_status:
                break
            normalized = normalize_status(new_status)
            if normalized:
                entry.set_field("Status", normalized)
                entry_changed = True
                break
        new_owner = prompt_choice("New owner (leave blank to keep): ")
        if new_owner:
            entry.set_field("Owner", new_owner)
            entry_changed = True
        new_links = prompt_choice("Update follow-up links (leave blank to keep): ")
        if new_links:
            entry.set_field("Follow-up Links", new_links)
            entry_changed = True
        if entry_changed:
            entry.ledger_path.write_text("".join(entry.lines))
            update_index(entry)
            print("Saved changes.")
    if not entries:
        print("No ledger entries found yet. Add entries before running the review.")
    elif interactive and not attention_seen:
        print("All entries are outside the attention set. Nothing to update.")


def main() -> None:
    parser = argparse.ArgumentParser(description="Review meta-learning ledgers.")
    parser.add_argument(
        "--all",
        action="store_true",
        help="List every ledger entry (read-only) without prompts",
    )
    args = parser.parse_args()

    attention = set(ALLOWED_STATUSES) if args.all else ATTENTION_STATUSES
    entries = load_ledgers(attention)
    process_entries(entries, interactive=not args.all)


if __name__ == "__main__":
    main()
