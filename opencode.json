{
  "plugin": [
    "opencode-beads"
  ],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "$env:CONTEXT7_API_KEY}",
        "Accept": "application/json, text/event-stream"
      },
      "enabled": true
    },
    "exa": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "exa-mcp-server"
      ],
      "timeout": 60000,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "railway": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@railway/mcp-server"
      ]
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
