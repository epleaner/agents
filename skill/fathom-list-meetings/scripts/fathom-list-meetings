#!/usr/bin/env bash
set -euo pipefail

# Fathom API - List Meetings
# Fetches meetings from Fathom within a specified date range
#
# Usage:
#   .opencode/skill/fathom-list-meetings/scripts/fathom-list-meetings [options]
#
# Options:
#   --after <timestamp>       ISO 8601 timestamp for start of range (default: 7 days ago)
#   --before <timestamp>      ISO 8601 timestamp for end of range (default: now)
#   --include-action-items    Include action items for each meeting
#   --include-summary         Include AI-generated summary for each meeting
#   --limit <n>               Maximum number of meetings to return (default: 50)
#   --help                    Show this help message
#
# Environment:
#   FATHOM_API_KEY           Required. Your Fathom API key (or set in .env file).

# Load .env file if it exists
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
if [[ -f "$ROOT_DIR/.env" ]]; then
    set -a
    source "$ROOT_DIR/.env"
    set +a
fi

FATHOM_API_BASE="https://api.fathom.ai/external/v1"

# Default values
AFTER=""
BEFORE=""
INCLUDE_ACTION_ITEMS="false"
INCLUDE_SUMMARY="false"
LIMIT="50"

show_help() {
    sed -n '3,17p' "$0" | sed 's/^# //' | sed 's/^#//'
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --after)
            AFTER="$2"
            shift 2
            ;;
        --before)
            BEFORE="$2"
            shift 2
            ;;
        --include-action-items)
            INCLUDE_ACTION_ITEMS="true"
            shift
            ;;
        --include-summary)
            INCLUDE_SUMMARY="true"
            shift
            ;;
        --limit)
            LIMIT="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac
done

# Check for API key
if [[ -z "${FATHOM_API_KEY:-}" ]]; then
    echo "Error: FATHOM_API_KEY environment variable is not set" >&2
    echo "Get your API key from: https://fathom.video/customize#api-access-header" >&2
    exit 1
fi

# Check for required tools
if ! command -v curl &> /dev/null; then
    echo "Error: curl is required but not installed" >&2
    exit 1
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq is required but not installed" >&2
    exit 1
fi

# Build query parameters
QUERY_PARAMS=""

if [[ -n "$AFTER" ]]; then
    QUERY_PARAMS="${QUERY_PARAMS}&created_after=${AFTER}"
fi

if [[ -n "$BEFORE" ]]; then
    QUERY_PARAMS="${QUERY_PARAMS}&created_before=${BEFORE}"
fi

if [[ "$INCLUDE_ACTION_ITEMS" == "true" ]]; then
    QUERY_PARAMS="${QUERY_PARAMS}&include_action_items=true"
fi

if [[ "$INCLUDE_SUMMARY" == "true" ]]; then
    QUERY_PARAMS="${QUERY_PARAMS}&include_summary=true"
fi

QUERY_PARAMS="${QUERY_PARAMS}&limit=${LIMIT}"

# Remove leading &
QUERY_PARAMS="${QUERY_PARAMS#&}"

# Make API request
RESPONSE=$(curl -s -w "\n%{http_code}" \
    --request GET \
    --url "${FATHOM_API_BASE}/meetings?${QUERY_PARAMS}" \
    --header "X-Api-Key: ${FATHOM_API_KEY}" \
    --header "Content-Type: application/json")

# Extract HTTP status code (last line)
HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
# Extract body (everything except last line)
BODY=$(echo "$RESPONSE" | sed '$d')

# Check for errors
if [[ "$HTTP_CODE" -ne 200 ]]; then
    echo "Error: API request failed with status $HTTP_CODE" >&2
    echo "$BODY" >&2
    exit 1
fi

# Output formatted JSON
echo "$BODY" | jq '.'
