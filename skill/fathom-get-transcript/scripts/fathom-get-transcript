#!/usr/bin/env bash
set -euo pipefail

# Fathom API - Get Transcript
# Fetches the full transcript for a specific meeting recording
#
# Usage:
#   .opencode/skill/fathom-get-transcript/scripts/fathom-get-transcript --recording-id <id> [options]
#
# Options:
#   --recording-id <id>    Required. The recording ID from Fathom
#   --format <format>      Output format: json (default) or text
#   --help                 Show this help message
#
# Environment:
#   FATHOM_API_KEY        Required. Your Fathom API key (or set in .env file).

# Load .env file if it exists
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
if [[ -f "$ROOT_DIR/.env" ]]; then
    set -a
    source "$ROOT_DIR/.env"
    set +a
fi

FATHOM_API_BASE="https://api.fathom.ai/external/v1"

# Default values
RECORDING_ID=""
FORMAT="json"

show_help() {
    sed -n '3,15p' "$0" | sed 's/^# //' | sed 's/^#//'
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --recording-id)
            RECORDING_ID="$2"
            shift 2
            ;;
        --format)
            FORMAT="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac
done

# Validate required parameters
if [[ -z "$RECORDING_ID" ]]; then
    echo "Error: --recording-id is required" >&2
    echo "Use --help for usage information" >&2
    exit 1
fi

# Check for API key
if [[ -z "${FATHOM_API_KEY:-}" ]]; then
    echo "Error: FATHOM_API_KEY environment variable is not set" >&2
    echo "Get your API key from: https://fathom.video/customize#api-access-header" >&2
    exit 1
fi

# Check for required tools
if ! command -v curl &> /dev/null; then
    echo "Error: curl is required but not installed" >&2
    exit 1
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq is required but not installed" >&2
    exit 1
fi

# Make API request
RESPONSE=$(curl -s -w "\n%{http_code}" \
    --request GET \
    --url "${FATHOM_API_BASE}/recordings/${RECORDING_ID}/transcript" \
    --header "X-Api-Key: ${FATHOM_API_KEY}" \
    --header "Content-Type: application/json")

# Extract HTTP status code (last line)
HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
# Extract body (everything except last line)
BODY=$(echo "$RESPONSE" | sed '$d')

# Check for errors
if [[ "$HTTP_CODE" -ne 200 ]]; then
    echo "Error: API request failed with status $HTTP_CODE" >&2
    echo "$BODY" >&2
    exit 1
fi

# Output based on format
case "$FORMAT" in
    json)
        echo "$BODY" | jq '.'
        ;;
    text)
        echo "$BODY" | jq -r '.transcript[] | "[\(.timestamp)] \(.speaker.display_name): \(.text)"'
        ;;
    *)
        echo "Error: Unknown format '$FORMAT'. Use 'json' or 'text'" >&2
        exit 1
        ;;
esac
